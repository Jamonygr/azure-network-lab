# Nonsecret template. Keep real values in ignored terraform.tfvars.
subscription_id = "00000000-0000-0000-0000-000000000000"
ctx = {
  project = "az700lab"
  location = "westeurope"
  tags = {
    Environment = "Lab"
    Project = "az700lab"
    ManagedBy = "Terraform"
    Purpose = "AZ-700 Networking Lab"
  }
}
# Minimal: resource group, three VNets/subnets, NSGs and bidirectional spoke peering.
# Choose ONE profiles/*.tfvars.example overlay to opt in to charged services.
deploy = { log_analytics = false, spoke_peering = true }
# Password/PSK are required only for enabled VMs/VPN; use TF_VAR_* values.
